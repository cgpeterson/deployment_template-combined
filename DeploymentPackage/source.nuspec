<?xml version="1.0"?>
<package>
  <metadata minClientVersion="3.3.0">
    <id>JMCL.Dataverse.DeploymentTemplate.Sources</id>
    <version>$version$</version>
    <description>PowerShell scripts and base template for creating deployment packages for Power Apps and Dynamics CE.</description>
    <authors>Jeff Maughan</authors>
    <owners>Jeff Maughan</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>    
    <projectUrl>https://github.com/geophray/deployment_template</projectUrl>
    <tags></tags>
    <dependencies>
      <dependency id="Microsoft.CrmSdk.UII.CommonAssemblies" version="9.0.0.10" />
      <dependency id="Microsoft.CrmSdk.Deployment" version="9.0.2.26" />
    </dependencies>
  </metadata>
  <files>
    <file src="JmclImportExtension.cs" target="content/" />    
    <file src="DevOps\**\*.ps1" target="content/DevOps" />
	<file src="DevOps\Tools\**" target="content/DevOps/Tools" exclude="DevOps\Tools\MyCdsSandboxConnection.ps1" />
  </files>
</package>
